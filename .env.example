# Copy to .env and choose your own local development passwords.
MYSQL_PASSWORD=replace-with-your-local-password
MYSQL_ROOT_PASSWORD=replace-with-your-local-root-password
# Keep the password consistent with MYSQL_PASSWORD; URL-encode special characters.
DATABASE_URL=mysql+pymysql://energy:replace-with-your-local-password@127.0.0.1:3307/energy?charset=utf8mb4
# Optional future advisor integration (not needed for homework).
OPENAI_API_KEY=
